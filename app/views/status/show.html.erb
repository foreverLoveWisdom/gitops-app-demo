<% if @error %>
  <pre style="color:red"><%= @error %></pre>
<% else %>
  <% sync = @app.dig("status", "sync", "status") %>
  <% health = @app.dig("status", "health", "status") %>

  <h1>nginx-demo</h1>
  <p>
    <a href="https://localhost:8080/applications/<%= @app.dig("metadata", "name") %>" target="_blank">
      Open in ArgoCD UI &rarr;
    </a>
  </p>
  <p style="color:gray;font-size:0.9em">Checked at: <%= @checked_at.strftime("%Y-%m-%d %H:%M:%S %Z") %></p>
  <p>
    Sync:
    <strong style="color: <%= sync == "Synced" ? "green" : "orange" %>"><%= sync %></strong>
    &nbsp;|&nbsp;
    Health:
    <strong style="color: <%= health == "Healthy" ? "green" : "red" %>"><%= health %></strong>
  </p>

  <table border="1" cellpadding="6">
    <tr><th>Kind</th><th>Name</th><th>Status</th><th>Health</th></tr>
    <% (@app.dig("status", "resources") || []).each do |r| %>
      <tr>
        <td><%= r["kind"] %></td>
        <td><%= r["name"] %></td>
        <td><%= r["status"] %></td>
        <td><%= r.dig("health", "status") %></td>
      </tr>
    <% end %>
  </table>

  <h2>Pods</h2>
  <table border="1" cellpadding="6">
    <tr><th>Name</th><th>Status</th><th>Image</th><th>Restarts</th></tr>
    <% (@pods || []).each do |pod| %>
      <% status = pod.dig("status", "phase") %>
      <% container_status = pod.dig("status", "containerStatuses", 0) %>
      <% waiting_reason = container_status&.dig("state", "waiting", "reason") %>
      <% display_status = waiting_reason || status %>
      <tr>
        <td><%= pod.dig("metadata", "name") %></td>
        <td style="color: <%= display_status == "Running" ? "green" : "red" %>"><%= display_status %></td>
        <td><%= pod.dig("spec", "containers", 0, "image") %></td>
        <td><%= container_status&.dig("restartCount") %></td>
      </tr>
    <% end %>
  </table>
<% end %>
